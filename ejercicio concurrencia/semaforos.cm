const int TAMANYO_BUFFER = 5;

const 
    int RED = 1; int BLACK = 2; int BLUE = 3; int YELLOW = 4; int GREEN = 5;
    int MAGENTA = 6; int WHITE = 7;
const
    int CIRCLE = 1; int LINE = 2; int RECTANGLE = 3; int TRIANGLE = 4; int RNDRECT = 6;

const
    int ID_PROD = 20; int ID_CONS = 30;

const int TIEMPO_PROD = 15;
const int TIEMPO_CONS = 15;
const int TIEMPO_ESPERA = 10;

semaphore mutex = 1;
semaphore huecos = TAMANYO_BUFFER;
semaphore llenos = 0;

int buffer[TAMANYO_BUFFER];

int contProductor = 0;
int contConsumidor = 0;
int dato = 1;

void pausa(int espera)
{
    int k;
    for (k = 0; k < espera; k++)
    {
        // mini pausa para visualizar los estados
    }
}

void inicializar_graficos()
{
    int i;
    for(i = 0; i < TAMANYO_BUFFER; i++)
    {
        create(i + 1, RNDRECT, WHITE, 160, 40 + (i * 45), 70, 35);
    }

    create(ID_PROD, TRIANGLE, YELLOW, 60, 45, 50, 40);
    create(ID_CONS, CIRCLE, YELLOW, 280, 45, 45, 45);
}

int producir()
{
    int nuevo_dato;
    pausa(TIEMPO_PROD);
    nuevo_dato = dato;
    dato = dato + 1;
    return nuevo_dato;
}

void consumir(int dato_sacado)
{
    pausa(TIEMPO_CONS);
}

void anyadir_buffer(int item)
{
    buffer[contProductor] = item;

    changecolor(contProductor + 1, GREEN);
    changecolor(ID_PROD, BLUE);
    changecolor(ID_CONS, YELLOW);

    pausa(TIEMPO_ESPERA);

    contProductor = (contProductor + 1) % TAMANYO_BUFFER;
    changecolor(ID_PROD, YELLOW);
}

int coger_buffer()
{
    int dato_sacado;
    dato_sacado = buffer[contConsumidor];

    changecolor(contConsumidor + 1, WHITE);
    changecolor(ID_PROD, YELLOW);
    changecolor(ID_CONS, MAGENTA);

    pausa(TIEMPO_ESPERA);

    contConsumidor = (contConsumidor + 1) % TAMANYO_BUFFER;
    changecolor(ID_CONS, YELLOW);

    return dato_sacado;
}

void productor()
{
    int i;
    int item;
    for (i = 0; i < 15; i++)
    {
        item = producir();

        wait(huecos);
        wait(mutex);
        anyadir_buffer(item);
        signal(mutex);
        signal(llenos);
    }
}

void consumidor()
{
    int i;
    int dato_sacado;
    for (i = 0; i < 15; i++)
    {
        wait(llenos);
        wait(mutex);
        dato_sacado = coger_buffer();
        signal(mutex);
        signal(huecos);

        consumir(dato_sacado);
    }
}

void main()
{
    int i;

    for(i = 0; i < TAMANYO_BUFFER; i++)
    {
        buffer[i] = 0;
    }
    
    inicializar_graficos();

    cobegin
    {
        productor();
        consumidor();
    }
}